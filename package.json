{
  "name": "campusfind",
  "version": "1.0.0",
  "private": true,
  "description": "Campus lost and found management system",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "seed:demo": "npm run seed:demo --workspace server",
    "seed:admin-demo": "npm run seed:admin-demo --workspace server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "concurrently": "^9.1.2",
    "jsdom": "^31.0.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
